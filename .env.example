# ==============================================================================
# HRYAAR Digi-PoSH Multi-Tenant SaaS Platform Configuration
# ==============================================================================

# Project Information
PROJECT_NAME="HRYAAR Digi-PoSH Multi-Tenant SaaS"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# JWT Cryptography Key (Generate a 64+ char random token in production)
SECRET_KEY="replace_with_a_secure_random_64_character_hex_string_for_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local Development (SQLite zero-configuration):
DATABASE_URL="sqlite:///./hryaar_posh.db"
# Production / Staging (PostgreSQL / Supabase / AWS RDS):
# DATABASE_URL="postgresql+psycopg://postgres:your_password@db.your-provider.com:5432/posh_saas"

# Static File Uploads Directory (Local or Mount Path)
UPLOAD_DIR="app/static/uploads"

# Allowed CORS Origins (Frontend domains)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","https://app.hryaar.com"]

# Default Super Admin Seed Credentials (for initial deployment bootstrapping)
INITIAL_SUPERADMIN_EMAIL="superadmin@hryaar.com"
INITIAL_SUPERADMIN_PASSWORD="ChangeMe@Production2026"

